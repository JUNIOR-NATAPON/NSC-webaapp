rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT TRADEOFF: this project is separate from the one that holds
    // your user accounts, so request.auth.uid here is an ANONYMOUS uid
    // (from signInAnonymously in src/lib/firebase.js) — it has no
    // relationship to a specific person's account. These rules can only
    // check "is this some authenticated client" not "is this the owner."
    //
    // That means ownerUid-based access control (like the primary project's
    // firestore.rules) isn't possible here without extra plumbing — e.g. a
    // Cloud Function that mints a custom token embedding the primary
    // project's uid as a claim, then checking that claim here instead.
    //
    // For a personal/hobby setup this is usually an acceptable tradeoff:
    // anyone with your device project's API key (which ships in your
    // client bundle regardless) can read/write any device's data. If that's
    // not acceptable for your use case, keep devices in the primary project
    // instead (the default — don't set VITE_FIREBASE_DEVICE_* at all).

    match /devices/{deviceId} {
      allow read, create, update: if request.auth != null;

      match /readings/{readingId} {
        allow read, create: if request.auth != null;
      }

      match /filterLog/{logId} {
        allow read, create: if request.auth != null;
      }
    }
  }
}
