# Copy this file to ".env" and fill in the values from your Firebase project.
# Firebase Console → Project settings → General → Your apps → SDK setup and configuration

# --- Main Firebase project (Authentication + Firestore) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- (Optional) Separate Firebase project for device/sensor data ---
# If these are filled in, all device/reading/filterLog data is routed to
# this project instead of the main project above.
# If left empty, the main project is used for everything — no changes needed.
VITE_FIREBASE_DEVICE_API_KEY=
VITE_FIREBASE_DEVICE_AUTH_DOMAIN=
VITE_FIREBASE_DEVICE_PROJECT_ID=
VITE_FIREBASE_DEVICE_STORAGE_BUCKET=
VITE_FIREBASE_DEVICE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DEVICE_APP_ID=
