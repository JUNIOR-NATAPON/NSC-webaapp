# Copy this file to ".env" and fill in the values from your Firebase project.
# Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only fill these in if you want device/sensor data (devices,
# readings, filterLog) to live in a SEPARATE Firebase project from user
# accounts. Leave all blank to keep everything in one project (default).
# See README "Using a separate Firebase project for device data" section.

VITE_FIREBASE_DEVICE_API_KEY=
VITE_FIREBASE_DEVICE_AUTH_DOMAIN=
VITE_FIREBASE_DEVICE_PROJECT_ID=
VITE_FIREBASE_DEVICE_STORAGE_BUCKET=
VITE_FIREBASE_DEVICE_MESSAGING_SENDER_ID=
VITE_FIREBASE_DEVICE_APP_ID=
