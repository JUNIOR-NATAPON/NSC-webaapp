rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Open rules for competition testing/demo
    match /users/{uid} {
      allow read, write: if true;
    }
    match /devices/{deviceId} {
      allow read, write: if true;
      match /readings/{readingId} {
        allow read, write: if true;
      }
      match /filterLog/{logId} {
        allow read, write: if true;
      }
    }
  }
}
