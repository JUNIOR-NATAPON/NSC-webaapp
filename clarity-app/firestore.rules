rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read/write their own profile doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Devices: a user can read/write devices they own. Your hardware
    // should authenticate with a service account or a dedicated device
    // user, or write through a trusted backend (e.g. Cloud Functions),
    // rather than using a regular user's credentials.
    match /devices/{deviceId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerUid == request.auth.uid;

      match /readings/{readingId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid;
      }

      match /filterLog/{logId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid;
        allow create: if request.auth != null
          && get(/databases/$(database)/documents/devices/$(deviceId)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
